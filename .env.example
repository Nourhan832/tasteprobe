# Configure these in your server host's environment. This file is documentation,
# not auto-loaded by the Python app. Never commit a real credential.
QLOO_API_KEY=
# The event-supported default. Use HTTP only with organizer approval.
QLOO_TRANSPORT=harness
# Optional when using qloo setup --qloo private config rather than env credentials:
QLOO_ENABLED=0
# Windows only: absolute paths to official harness dist/bin.js and node.exe.
QLOO_HARNESS_ENTRY=
QLOO_NODE=
QLOO_API_HOST=https://api.qloo.com
# Set to the actual HTTPS origin on an external host.
APP_ORIGIN=http://127.0.0.1:8766
PORT=8766
